{
    "compilerOptions": {
        "strict": true,
        "module": "ESNext",
        "target": "ESNext",
        // Doesn't apply to server/, see ts-node config down below and server/tsconfig.json
        "moduleResolution": "Bundler",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "types": ["vite-plugin-svgr/client", "vite/client"],
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "paths": {
            "#/*": ["./src/*"],
        },
    },
    "ts-node": {
        "transpileOnly": true,
        "esm": true,
        "compilerOptions": {
            "module": "Node16",
            "moduleResolution": "Node16",
        },
    },
}
